{
  "name": "agent-harness-curriculum-site",
  "private": true,
  "description": "The HTML edition of the agent-harness curriculum. The course itself is the Markdown in this folder.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
