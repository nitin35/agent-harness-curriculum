    "find:runnable": "node --experimental-vm-modules --disable-warning=ExperimentalWarning scripts/runnable.mjs --find",
    "check:runnable": "node --experimental-vm-modules --disable-warning=ExperimentalWarning scripts/runnable.mjs --check"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "acorn": "^8.18.0",
    "codemirror": "^6.0.2",
    "github-slugger": "^2.0.0",
    "idb-keyval": "^6.3.0",
    "mermaid": "^12.1.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.43"
  }
}
